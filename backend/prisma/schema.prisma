generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  roleId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id])
  
  isVerified            Boolean  @default(false)
  isActive              Boolean  @default(true)
  verificationToken     String?  @unique
  verificationTokenExpires DateTime?
  resetPasswordToken    String?  @unique
  resetPasswordExpires  DateTime?
  lastLogin             DateTime?
  rememberToken         String?  @unique
  
  // Farm relationships
  farms     Farm[]
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

// ============================================
// FARM MODULE - NEW MODELS
// ============================================

model Farm {
  id          Int      @id @default(autoincrement())
  name        String
  location    String
  size        Float?   // Size in hectares
  description String?
  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id])
  
  crops       Crop[]
  animals     Animal[]
  inventory   Inventory[]
  assets      Asset[]
  expenses    Expense[]
  revenues    Revenue[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Asset {
  id                      Int               @id @default(autoincrement())
  assetCode               String            @unique
  name                    String
  category                AssetCategory     @default(TRACTORS)
  farmId                  Int
  farm                    Farm              @relation(fields: [farmId], references: [id], onDelete: Cascade)
  location                String?
  purchaseDate            DateTime
  purchasePrice           Float
  currentValue            Float
  status                  AssetStatus       @default(IN_USE)
  condition               AssetCondition    @default(GOOD)
  imageUrl                String?
  serialNumber            String?
  modelNumber             String?
  manufacturer            String?
  year                    Int?
  notes                   String?
  nextMaintenanceDate     DateTime?
  lastMaintenanceDate     DateTime?
  maintenanceIntervalDays Int?              @default(90)
  depreciationRate        Float?            @default(10)

  maintenanceLogs         AssetMaintenance[]

  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

model AssetMaintenance {
  id            Int                @id @default(autoincrement())
  assetId       Int
  asset         Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title         String
  type          MaintenanceType    @default(ROUTINE)
  status        MaintenanceStatus  @default(SCHEDULED)
  scheduledDate DateTime
  completedDate DateTime?
  cost          Float?             @default(0)
  technician    String?
  description   String?
  notes         String?

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Crop {
  id          Int      @id @default(autoincrement())
  name        String
  variety     String?
  plantingDate DateTime
  harvestDate  DateTime?
  yield       Float?   // Yield in kg
  area        Float?   // Area planted in hectares
  farmId      Int
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  status      CropStatus @default(PLANTED)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Animal {
  id          Int      @id @default(autoincrement())
  name        String
  type        AnimalType
  breed       String?
  age         Int?
  healthStatus HealthStatus @default(HEALTHY)
  farmId      Int
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inventory {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  quantity    Float
  unit        String
  minStock    Float?
  farmId      Int
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float
  category    String
  date        DateTime @default(now())
  farmId      Int
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Revenue {
  id          Int      @id @default(autoincrement())
  source      String
  amount      Float
  date        DateTime @default(now())
  farmId      Int
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AssetCategory {
  TRACTORS
  HARVESTERS
  IMPLEMENTS
  VEHICLES
  IRRIGATION
  POWER_EQUIPMENT
  STORAGE_PROCESSING
  TOOLS
  OTHERS
}

enum AssetStatus {
  IN_USE
  UNDER_MAINTENANCE
  INACTIVE
  DECOMMISSIONED
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  CRITICAL
}

enum MaintenanceType {
  ROUTINE
  REPAIR
  OVERHAUL
  INSPECTION
  EMERGENCY
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum CropStatus {
  PLANTED
  GROWING
  HARVESTED
  FAILED
}

enum AnimalType {
  CATTLE
  SHEEP
  GOAT
  PIG
  POULTRY
  OTHER
}

enum HealthStatus {
  HEALTHY
  SICK
  UNDER_TREATMENT
  QUARANTINED
}