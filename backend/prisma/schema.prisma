generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  roleId    Int
  organizationId Int?
  farmId    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farm      Farm?    @relation("FarmWorkers", fields: [farmId], references: [id], onDelete: SetNull)
  
  isVerified            Boolean  @default(false)
  isActive              Boolean  @default(true)
  verificationToken     String?  @unique
  verificationTokenExpires DateTime?
  resetPasswordToken    String?  @unique
  resetPasswordExpires  DateTime?
  lastLogin             DateTime?
  rememberToken         String?  @unique
  
  // Farm relationships
  ownedFarms     Farm[]  @relation("FarmOwner")
  attendanceLogs AttendanceLog[]
  trainingEnrollments TrainingEnrollment[]
  payrollRecords PayrollRecord[]
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  organizationId Int?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  permissions RolePermission[]

  @@unique([organizationId, name])
}

model Organization {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  roles       Role[]
  farms       Farm[]
  subscriptions Subscription[]
  supportTickets SupportTicket[]
  trainingPrograms TrainingProgram[]
}

model Plan {
  id           Int      @id @default(autoincrement())
  name         String
  code         String   @unique
  description  String?
  monthlyPrice Float    @default(0)
  maxFarms     Int?
  maxUsers     Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id               Int      @id @default(autoincrement())
  organizationId   Int
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId           Int
  plan             Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  status           String   @default("TRIALING")
  startsAt         DateTime @default(now())
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  canceledAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId, status])
}

model SupportTicket {
  id             Int      @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subject        String
  description    String
  status         String   @default("OPEN")
  priority       String   @default("NORMAL")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Permission {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AttendanceLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  checkIn   DateTime?
  checkOut  DateTime?
  status    String   @default("PRESENT")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
}

model TrainingProgram {
  id           Int      @id @default(autoincrement())
  title        String
  instructor   String?
  scheduledDate DateTime
  status       String   @default("UPCOMING")
  description  String?
  organizationId Int?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments  TrainingEnrollment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TrainingEnrollment {
  id         Int      @id @default(autoincrement())
  programId  Int
  userId     Int
  program    TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     String   @default("ENROLLED")
  completedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([programId, userId])
}

model PayrollRecord {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      String
  grossAmount Float
  deductions  Float    @default(0)
  netAmount   Float
  status      String   @default("PENDING")
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, period])
  @@index([period])
}

// ============================================
// FARM MODULE - NEW MODELS
// ============================================

model Farm {
  id          Int      @id @default(autoincrement())
  name        String
  location    String
  size        Float?   // Size in hectares
  description String?
  ownerId     Int
  organizationId Int
  owner       User     @relation("FarmOwner", fields: [ownerId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUsers User[] @relation("FarmWorkers")
  
  crops       Crop[]
  animals     Animal[]
  inventory   Inventory[]
  assets      Asset[]
  transactions Transaction[]
  invoices    Invoice[]
  budgets     Budget[]
  approvalRequests ApprovalRequest[]
  activityLogs FarmActivityLog[]
  expenses    Expense[]
  revenues    Revenue[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
}

model Asset {
  id                      Int               @id @default(autoincrement())
  assetCode               String            @unique
  name                    String
  category                AssetCategory     @default(TRACTORS)
  farmId                  Int
  farm                    Farm              @relation(fields: [farmId], references: [id], onDelete: Cascade)
  location                String?
  purchaseDate            DateTime
  purchasePrice           Float
  currentValue            Float
  status                  AssetStatus       @default(IN_USE)
  condition               AssetCondition    @default(GOOD)
  imageUrl                String?
  serialNumber            String?
  modelNumber             String?
  manufacturer            String?
  year                    Int?
  notes                   String?
  nextMaintenanceDate     DateTime?
  lastMaintenanceDate     DateTime?
  maintenanceIntervalDays Int?              @default(90)
  depreciationRate        Float?            @default(10)

  maintenanceLogs         AssetMaintenance[]

  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

model AssetMaintenance {
  id            Int                @id @default(autoincrement())
  assetId       Int
  asset         Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title         String
  type          MaintenanceType    @default(ROUTINE)
  status        MaintenanceStatus  @default(SCHEDULED)
  scheduledDate DateTime
  completedDate DateTime?
  cost          Float?             @default(0)
  technician    String?
  description   String?
  notes         String?

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Crop {
  id          Int      @id @default(autoincrement())
  name        String
  variety     String?
  plantingDate DateTime
  harvestDate  DateTime?
  yield       Float?   // Yield in kg
  area        Float?   // Area planted in hectares
  farmId      Int
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  status      CropStatus @default(PLANTED)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Animal {
  id          Int      @id @default(autoincrement())
  name        String
  type        AnimalType
  breed       String?
  age         Int?
  healthStatus HealthStatus @default(HEALTHY)
  farmId      Int
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inventory {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  quantity    Float
  unit        String
  minStock    Float?
  farmId      Int
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float
  category    String
  date        DateTime @default(now())
  farmId      Int
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Revenue {
  id          Int      @id @default(autoincrement())
  source      String
  amount      Float
  date        DateTime @default(now())
  farmId      Int
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AssetCategory {
  TRACTORS
  HARVESTERS
  IMPLEMENTS
  VEHICLES
  IRRIGATION
  POWER_EQUIPMENT
  STORAGE_PROCESSING
  TOOLS
  OTHERS
}

enum AssetStatus {
  IN_USE
  UNDER_MAINTENANCE
  INACTIVE
  DECOMMISSIONED
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  CRITICAL
}

enum MaintenanceType {
  ROUTINE
  REPAIR
  OVERHAUL
  INSPECTION
  EMERGENCY
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum CropStatus {
  PLANTED
  GROWING
  HARVESTED
  FAILED
}

enum AnimalType {
  CATTLE
  SHEEP
  GOAT
  PIG
  POULTRY
  OTHER
}

enum HealthStatus {
  HEALTHY
  SICK
  UNDER_TREATMENT
  QUARANTINED
}

// ============================================
// FINANCE & ACCOUNTING MODELS
// ============================================

model Transaction {
  id            Int                @id @default(autoincrement())
  reference     String             @unique // INV-2025-0052, EXP-2025-0087, PAY-2025-0041, etc.
  date          DateTime           @default(now())
  description   String
  category      String             // Sales Revenue, Farm Inputs, Payroll, Fuel & Transport, etc.
  account       String             @default("Operating Account") // Sales Account, Operating Account, Payroll Account, etc.
  type          TransactionType    @default(EXPENSE) // INCOME, EXPENSE
  amount        Float
  status        TransactionStatus  @default(COMPLETED)
  farmId        Int?
  farm          Farm?              @relation(fields: [farmId], references: [id], onDelete: SetNull)
  invoiceId     Int?
  invoice       Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentMethod String?            @default("Bank Transfer")
  notes         String?

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Invoice {
  id            Int                @id @default(autoincrement())
  invoiceNumber String             @unique // INV-2025-0052, etc.
  title         String
  customer      String?
  customerEmail String?
  issueDate     DateTime           @default(now())
  dueDate       DateTime
  amount        Float
  paidAmount    Float              @default(0)
  status        InvoiceStatus      @default(PENDING)
  type          InvoiceType        @default(RECEIVABLE)
  farmId        Int?
  farm          Farm?              @relation(fields: [farmId], references: [id], onDelete: SetNull)
  notes         String?
  
  transactions  Transaction[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Budget {
  id              Int              @id @default(autoincrement())
  name            String
  category        String
  allocatedAmount Float
  spentAmount     Float            @default(0)
  period          String           @default("2025 Season A")
  startDate       DateTime
  endDate         DateTime
  farmId          Int?
  farm            Farm?            @relation(fields: [farmId], references: [id], onDelete: SetNull)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model FinancialAccount {
  id            Int                @id @default(autoincrement())
  name          String             @unique // Operating Account, Sales Account, Payroll Account, etc.
  accountNumber String?
  bankName      String?
  balance       Float              @default(0)
  type          String             @default("Checking") // Checking, Savings, Cash, Credit

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  COMPLETED
  PENDING
  CANCELLED
  FAILED
}

enum InvoiceStatus {
  PAID
  SENT
  PENDING
  OVERDUE
  DRAFT
  CANCELLED
}

enum InvoiceType {
  RECEIVABLE
  PAYABLE
}

// ============================================
// MANAGING DIRECTOR & EXECUTIVE MODELS
// ============================================

model ApprovalRequest {
  id          Int            @id @default(autoincrement())
  title       String         // e.g. "Project Budget Approval - Green Valley Farm"
  category    String         // e.g. "Budget", "Procurement", "HR", "Finance", "Asset"
  requestedBy String?        // e.g. "Operations Manager", "Agronomist"
  amount      Float?
  meta        String?        // e.g. "$25,000", "3 days", "$12,500"
  status      ApprovalStatus @default(PENDING) // PENDING, FOR_REVIEW, APPROVED, REJECTED
  date        DateTime       @default(now())
  farmId      Int?
  farm        Farm?          @relation(fields: [farmId], references: [id], onDelete: SetNull)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model StrategicGoal {
  id             Int        @id @default(autoincrement())
  title          String     // e.g. "Increase crop production"
  target         String     // e.g. "Target: 600 tons"
  currentValue   Float
  targetValue    Float
  unit           String?    // tons, animals, USD, ha
  progressPercent Float     @default(0) // e.g. 72, 58, 65, 40
  category       String?    // PRODUCTION, LIVESTOCK, PROFITABILITY, INFRASTRUCTURE
  status         GoalStatus @default(IN_PROGRESS)
  deadline       DateTime?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model FarmActivityLog {
  id        Int      @id @default(autoincrement())
  title     String   // e.g. "New crop yield record updated (Maize)"
  type      String   @default("CROP") // CROP, LIVESTOCK, PROJECT, FINANCE, HR
  timestamp DateTime @default(now())
  details   String?
  farmId    Int?
  farm      Farm?    @relation(fields: [farmId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model ExecutiveReport {
  id        Int      @id @default(autoincrement())
  title     String   // e.g. "Financial Report (Q2 2025)"
  date      DateTime @default(now())
  format    String   @default("PDF") // PDF, Excel, CSV
  fileUrl   String?
  category  String?  // FINANCIAL, CROPS, LIVESTOCK, INVENTORY, PROJECTS

  createdAt DateTime @default(now())
}

enum ApprovalStatus {
  PENDING
  FOR_REVIEW
  APPROVED
  REJECTED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BEHIND
}